# wyrm coordination server. NOT YET TESTED under systemd: review before
# relying on it. Needs no privileges at all: both ports are above 1024.
#
# Admin commands talk to the socket inside the state directory, as root:
#   sudo wyrm coord authkey --dir /var/lib/wyrm-coord
[Unit]
Description=wyrm coordination server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wyrm coord serve --dir /var/lib/wyrm-coord --listen :8443 --stun :3478
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=wyrm-coord
StateDirectoryMode=0700

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
